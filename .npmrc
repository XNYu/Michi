# Pin the default registry to public npmjs. Without this, a contributor whose
# global ~/.npmrc points at a private/proxy registry resolves deps through it
# and rewrites the `resolved` URLs in package-lock.json to that private host.
registry=https://registry.npmjs.org/

# @mariozechner/pi-ai is a public npm package; route its scope to public npmjs
# so contributors on private/proxy registries can install it without waiting
# for their registry to mirror that scope.
@mariozechner:registry=https://registry.npmjs.org/
