# michi backend — copy to backend/.env and fill in your own values.
# Anything left blank uses the default documented in docs/environment.md.

# ─── server ─────────────────────────────────────────────────────────────────
PORT=3000
# NODE_ENV=production            # only in real deployments

# Where SQLite + agent config / sessions live. Docker uses /data.
# MICHI_DATA_DIR=/Users/me/.michi
# MICHI_LOG_DIR=/Users/me/.michi/logs

# ─── remote desktop access ─────────────────────────────────────────────────
# Expose this backend for a Michi desktop app on another machine. Remote access
# requires a bearer token (minimum 16 chars). It listens on loopback for Michi's
# built-in SSH tunnel; set MICHI_BIND_HOST to another interface only behind a
# firewall or private network. Keep MICHI_REQUIRE_AUTH off for this self-hosted
# desktop-to-backend mode.
# MICHI_REMOTE_ACCESS=1
# MICHI_REMOTE_TOKEN=                 # generate: openssl rand -hex 32
# MICHI_BIND_HOST=127.0.0.1            # the default; a wider bind must be set explicitly
# MICHI_SSH_BIN=/usr/bin/ssh           # local gateway override, normally unnecessary

# ─── runtime selection ─────────────────────────────────────────────────────
# Pi-only matches the cloud config and avoids needing the Claude / Kiro CLIs.
MICHI_ENABLED_RUNTIMES=pi
MICHI_DEFAULT_RUNTIME=pi

# ─── auth gate ─────────────────────────────────────────────────────────────
# Local dev / Electron: leave MICHI_REQUIRE_AUTH unset (defaults to off).
# Personal authenticated desktop: choose one verified Google email. This keeps
# local directories, provider keys and legacy ownerless data; it is not a
# multi-user isolation mode. For hosted multi-user service set MICHI_CLOUD=1
# instead (Docker defaults both CLOUD=1 and REQUIRE_AUTH=true).
# MICHI_REQUIRE_AUTH=true
# MICHI_LOCAL_AUTH_EMAIL=me@example.com
# MICHI_CLOUD=1
# MICHI_ADMIN_EMAILS=                 # independent admin allowlist, empty denies
# Auth requires the four values below in either authenticated mode.
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=                 # openssl rand -hex 32
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AES-256-GCM master key for the cloud per-user provider-key vault. Base64, 32 bytes.
# Generate with: openssl rand -base64 32
# Required for cloud BYOK keys. Keep the existing key on upgrade: losing it
# makes saved user_provider_keys in data.db unrecoverable. Local auth retains
# the desktop provider-key store instead.
# MICHI_ENCRYPTION_KEY=

# ─── Origins and hosts (backend/src/services/localOrigins.ts) ──────────────
# Without auth the backend serves only Michi's own UI: its own host,
# MICHI_RENDERER_URL, and loopback :3001 in a development build (npm run dev).
# Other origins get 403 (logged once each).
# Add a UI origin that is neither (LAN host name, dev tunnel, Codespaces):
# MICHI_CORS_ORIGINS=http://my-box.local:3001
# Allow pages on every loopback port (other local servers too):
# MICHI_ALLOW_LOOPBACK_ORIGINS=1
# Without remote access, Host headers naming a DNS host other than localhost
# are refused (DNS rebinding); IP addresses pass. Host names to accept (any
# port), e.g. a LAN name, local reverse proxy or tunnel:
# MICHI_ALLOWED_HOSTS=my-box.local,michi.my-tunnel.example

# ─── provider keys (Pi runtime fallback when no per-user key is set) ───────
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_PROFILE=default
# CLAUDE_CODE_USE_VERTEX=1
# GCP_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# ─── optional web search (Railway deployments only) ─────────────────────────
# The feature is enabled automatically only when Railway's project/environment/
# service identifiers are present. Set MICHI_WEB_SEARCH_ENABLED=0 as a Railway
# kill switch. Local, Electron, and other hosted builds do not expose search.
# MICHI_WEB_SEARCH_ENABLED=0
# MICHI_DEFAULT_WEB_SEARCH_PROVIDER=jina
# JINA_API_KEY=
# TAVILY_API_KEY=

# ─── claude-code runtime tuning (only if MICHI_ENABLED_RUNTIMES includes claude) ───
# CLAUDE_CLI_BIN=/usr/local/bin/claude
# MICHI_CLAUDE_MAX_CONCURRENT=10
# MICHI_CLAUDE_POOL_DISABLED=0
# MICHI_CLAUDE_INIT_TIMEOUT_MS=60000
# MICHI_CLAUDE_DISPOSE_TERM_TIMEOUT_MS=2000
# MICHI_CLAUDE_DISPOSE_KILL_TIMEOUT_MS=1000
# MICHI_CLAUDE_BARE=0
# MICHI_APPROVE_TIMEOUT_MS=300000

# ─── kiro runtime tuning ───────────────────────────────────────────────────
# KIRO_CLI_BIN=/usr/local/bin/kiro
# MICHI_KIRO_MAX_CONCURRENT=100

# ─── cursor CLI runtime (MICHI_ENABLED_RUNTIMES includes cursor) ────────────
# CURSOR_CLI_BIN=~/.local/bin/agent   # never ~/.grok/bin/agent (Grok CLI)
# CURSOR_API_KEY=
# CURSOR_AUTH_TOKEN=
# MICHI_CURSOR_MAX_CONCURRENT=100

# ─── grok CLI runtime (MICHI_ENABLED_RUNTIMES includes grok) ────────────────
# Official xAI Grok CLI only (not community `grok` binaries).
# GROK_CLI_BIN=/usr/local/bin/grok
# MICHI_GROK_MAX_CONCURRENT=100
# XAI_API_KEY is already the Pi xai provider key — do not register it twice.
# Auth prefers `grok login` cached_token, then XAI_API_KEY, then grok.com.
# Default model is grok-4.6. The Grok CLI runtime does not require XAI_API_KEY.
# XAI_API_KEY=


# ─── acp runtime tuning ────────────────────────────────────────────────────
# ACP_TIMEOUT_MS=30000

# ─── diagnostics ───────────────────────────────────────────────────────────
# Structured JSONL metrics facade. Keep off unless profiling.
# MICHI_METRICS=1
# MICHI_METRICS_RUN_ID=local-dev

# Legacy perf text logs. Also mirrors to MICHI_METRICS rows when enabled.
# MICHI_PERF=1
