{
  "name": "michi-app",
  "version": "0.3.2",
  "private": true,
  "author": "Nan Yu",
  "license": "ISC",
  "main": "electron/dist/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared",
    "runtime"
  ],
  "scripts": {
    "shared:build": "cd shared && npm run build",
    "backend:dev": "npm run shared:build && node scripts/dev.mjs --backend-only",
    "backend:build": "cd backend && npm run build",
    "backend:start": "cd backend && npm start",
    "frontend:dev": "npm run shared:build && cd frontend && npm run dev:raw",
    "frontend:build": "cd frontend && npm run build",
    "frontend:verify-bundle": "node scripts/verify-frontend-bundle.mjs",
    "frontend:start": "cd frontend && npm start",
    "predev": "node scripts/kill-stale-dev.mjs",
    "dev": "npm run shared:build && node scripts/dev.mjs",
    "build": "npm run frontend:build && npm run backend:build",
    "start": "cd backend && npm start",
    "remote:setup": "npm install --workspace backend --workspace shared --workspace runtime --workspace frontend --include-workspace-root=false --no-audit --no-fund && npm run build",
    "remote:start": "cd backend && MICHI_REMOTE_ACCESS=1 npm start",
    "remote:launch": "node scripts/remote-control.mjs launch",
    "remote:status": "node scripts/remote-control.mjs status",
    "remote:stop": "node scripts/remote-control.mjs stop",
    "remote:restart": "node scripts/remote-control.mjs restart",
    "remote:service:remove": "node scripts/remote-control.mjs remove-service",
    "server": "npm install && npm run build && node backend/dist/server.js",
    "electron:build-main": "tsc -p electron",
    "electron:prepare-binary": "node scripts/prepare-electron-binary.mjs",
    "electron:rebuild-native": "node scripts/rebuild-electron-natives.mjs",
    "preelectron:dev": "node scripts/kill-stale-dev.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:dev-wait": "node scripts/electron-dev-wait.mjs",
    "electron:build": "node scripts/electron-build.mjs",
    "postelectron:build": "node scripts/install-app.mjs",
    "electron:install": "node scripts/install-app.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "startup:analyze": "node scripts/analyze-startup.mjs",
    "metrics:analyze": "node scripts/analyze-metrics.mjs",
    "perf:pane": "node scripts/run-pane-perf.mjs",
    "perf:compare": "node scripts/compare-pane-perf.mjs",
    "test:electron-setup": "node --test scripts/prepare-electron-binary.test.mjs scripts/rebuild-electron-natives.test.mjs",
    "test:remote-setup": "node --test scripts/remote-setup.test.mjs",
    "test:runtime": "npm test -w michi-runtime && npm exec -w backend -- node --require ts-node/register --test --test-timeout=30000 test/runtimeBoundary.test.ts",
    "test:remote-control": "node --test scripts/remote-control.test.mjs scripts/michi-remote-launcher.test.mjs",
    "test:electron-shortcuts": "npm run electron:build-main && node --test scripts/electron-pane-shortcut.test.mjs && node scripts/run-electron-smoke.mjs native-shortcut",
    "test:electron-browser": "npm run electron:build-main && node --test scripts/electron-browser-bounds.test.mjs scripts/electron-browser-theme.test.mjs scripts/run-electron-smoke.test.mjs && node scripts/run-electron-smoke.mjs browser-theme",
    "test:electron-service": "npm run electron:build-main && node --test scripts/electron-background-service.test.mjs",
    "test:dev-port": "node --test scripts/find-open-port.test.mjs scripts/electron-dev-env.test.mjs scripts/kill-stale-dev.test.mjs scripts/lib/proc.test.mjs",
    "test:stream-transport": "node scripts/test-stream-transport.mjs",
    "test:perf": "node --test scripts/pane-perf-tools.test.mjs scripts/bench-startup.test.mjs scripts/jsonl-events.test.mjs",
    "test:contracts": "npm run shared:build && npm run electron:build-main && node --test scripts/build-info.test.mjs scripts/electron-browser-theme.test.mjs scripts/electron-preload-contract.test.mjs scripts/electron-windows-lifecycle.test.mjs scripts/electron-windows-lifetime-wiring.test.mjs scripts/electron-workspace-files.test.mjs scripts/native-content-boundary.test.mjs scripts/pages-real-runtime-helpers.test.mjs scripts/pages-real-ui-capability-evidence.test.mjs scripts/remote-auth.test.mjs scripts/knip-baseline.test.mjs scripts/icons.test.mjs",
    "check:knip": "node scripts/knip-baseline.mjs",
    "check:deps": "node backend/scripts/dependencyRules.cjs",
    "check": "npm run test:contracts && npm test -w michi-shared && npm run check:knip && npm run check:deps",
    "test:electron": "cd backend && node --require ts-node/register --test --test-timeout=30000 test/updateRelease.test.ts",
    "test:e2e": "npm run shared:build && playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "npm run shared:build && playwright test --config e2e/playwright.config.ts --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^8.0.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "knip": "5.88.1",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "fix-path": "^5.0.0",
    "node-pty": "^1.1.0"
  },
  "overrides": {
    "kysely": "0.28.17"
  },
  "build": {
    "appId": "com.michi.app",
    "productName": "michi",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/dist/**",
      "frontend/build/**",
      "backend/dist/**",
      "!backend/dist/frontend/**",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.cts",
      "!**/*.d.mts",
      "package.json"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "assets/icons/icon.ico",
        "to": "icon.ico"
      }
    ],
    "mac": {
      "target": {
        "target": "dmg",
        "arch": "arm64"
      },
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "multiLanguageInstaller": false,
      "language": "1033",
      "installerLanguages": ["en_US"]
    },
    "asar": true
  }
}
