# michi frontend — copy to frontend/.env.local for personal overrides.
# Vite inlines VITE_* at BUILD time, so changes need a dev-server restart
# or a fresh `npm run frontend:build`. See docs/environment.md.

# ─── api base URL ──────────────────────────────────────────────────────────
# Already set in .env.development / .env.production — only override here if
# you're pointing at a remote backend during local dev.
# VITE_API_URL=http://localhost:3000/api

# ─── feature flags ─────────────────────────────────────────────────────────
# Profile page (design-system port). Docker / Railway flips this to 1
# automatically; keep it 0 (or unset) for normal local dev / Electron.
# VITE_MICHI_PROFILE_PAGE=0

# ─── diagnostics ───────────────────────────────────────────────────────────
# Structured JSONL metrics facade. Keep off unless profiling.
# VITE_MICHI_METRICS=1
# VITE_MICHI_METRICS_RUN_ID=local-dev

# Legacy perf text logs. Also mirrors to VITE_MICHI_METRICS rows when enabled.
# VITE_MICHI_PERF=1

# Aggregated requestAnimationFrame sampler. Requires VITE_MICHI_METRICS=1.
# VITE_MICHI_FRAME_METRICS=1
# VITE_MICHI_FRAME_METRICS_WINDOW_MS=2000
