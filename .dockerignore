# Re-include the production frontend env (last, so it isn't re-excluded
# by **/.env.* above). Vite needs this file at build time to bake
# VITE_API_URL=/api into the bundle; without it the bundle falls back
# to http://localhost:3000/api and the deployed frontend can't talk
# to its backend.
!frontend/.env.production

