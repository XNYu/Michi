          "--agent-engine",
          "v2"
        ],
        "cwd": "/work",
        "env": "<inherited>"
      }
    ],
    "startup": [
      [
        "kiro_spawn_start",
        {
          "cwd": "/work",
          "binaryPath": "/fake/kiro-cli"
