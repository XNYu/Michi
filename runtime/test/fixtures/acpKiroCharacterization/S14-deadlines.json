[
  {
    "step": "setup"
  },
  {
    "step": "start",
    "log": [
      [
        "info",
        "acp",
        "kiro process spawned",
        {
          "pid": 4242,
          "cwd": "/work",
          "model": "<undefined>",
          "binaryPath": "/fake/kiro-cli"
        }
      ]
    ],
    "perf": [
      [
        "mark",
        "acp:spawn_requested",
        {
          "cwd": "/work",
          "pid": 4242
        }
      ]
    ],
    "spawn": [
      {
        "bin": "/fake/kiro-cli",
        "args": [
          "acp",
          "--agent-engine",
          "v2"
        ],
        "cwd": "/work",
        "env": "<inherited>"
      }
    ],
    "startup": [
      [
        "kiro_spawn_start",
        {
          "cwd": "/work",
          "binaryPath": "/fake/kiro-cli"
        }
      ],
      [
        "kiro_spawn_done",
        {
          "cwd": "/work",
          "pid": 4242
        }
      ]
    ]
  },
  {
    "step": "initialize with a deadline",
    "startup": [
      [
        "kiro_initialize_start",
        {
          "cwd": "/work"
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 0,
        "method": "initialize",
        "params": {
          "protocolVersion": 1,
          "clientInfo": {
            "name": "michi",
            "version": "1.0.0"
          },
          "clientCapabilities": {}
        }
      }
    ]
  },
  {
    "step": "initialize deadline",
    "=initialize": [
      {
        "error": "ACPError",
        "message": "Request initialize exceeded its 800ms recovery deadline",
        "method": "initialize"
      }
    ]
  },
  {
    "step": "initialize again",
    "=initialize2": [
      "<resolved>"
    ],
    "perf": [
      [
        "measure",
        "acp:initialize",
        {
          "cwd": "/work"
        }
      ]
    ],
    "startup": [
      [
        "kiro_initialize_start",
        {
          "cwd": "/work"
        }
      ],
      [
        "kiro_initialize_done",
        {
          "cwd": "/work"
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": 1,
          "clientInfo": {
            "name": "michi",
            "version": "1.0.0"
          },
          "clientCapabilities": {}
        }
      }
    ]
  },
  {
    "step": "session",
    "=newSession": [
      {
        "sessionId": "S1",
        "modes": {
          "currentModeId": "default",
          "availableModes": [
            {
              "id": "default",
              "name": "Default"
            },
            {
              "id": "planner",
              "name": "Planner"
            }
          ]
        },
        "models": {
          "currentModelId": "claude-x",
          "availableModels": [
            {
              "modelId": "claude-x",
              "name": "X"
            }
          ]
        }
      }
    ],
    "perf": [
      [
        "measure",
        "acp:session_new",
        {
          "cwd": "/work",
          "sessionId": "S1"
        }
      ]
    ],
    "startup": [
      [
        "kiro_session_new_start",
        {
          "cwd": "/work",
          "mcpServerCount": 0
        }
      ],
      [
        "kiro_session_new_done",
        {
          "cwd": "/work",
          "sessionId": "S1",
          "mcpServerCount": 0
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "session/new",
        "params": {
          "cwd": "/work",
          "mcpServers": []
        }
      }
    ]
  },
  {
    "step": "idle RPC",
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "session/set_mode",
        "params": {
          "sessionId": "S1",
          "modeId": "planner"
        }
      }
    ]
  },
  {
    "step": "600ms"
  },
  {
    "step": "progress resets it"
  },
  {
    "step": "600ms more"
  },
  {
    "step": "400ms more: idle",
    "=setMode": [
      {
        "error": "ACPError",
        "message": "Request session/set_mode idle for 1000ms (no updates from agent)",
        "method": "session/set_mode",
        "sessionId": "S1"
      }
    ]
  },
  {
    "step": "recovery deadline",
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "_kiro.dev/commands/execute",
        "params": {
          "sessionId": "S1",
          "command": {
            "command": "usage",
            "args": {}
          }
        }
      }
    ]
  },
  {
    "step": "600ms"
  },
  {
    "step": "session/update does not extend it"
  },
  {
    "step": "400ms more: deadline",
    "=command": [
      {
        "error": "ACPError",
        "message": "Request _kiro.dev/commands/execute exceeded its 1000ms recovery deadline",
        "method": "_kiro.dev/commands/execute",
        "sessionId": "S1"
      }
    ]
  },
  {
    "step": "recovery deadline and Kiro's extension update",
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "_kiro.dev/commands/execute",
        "params": {
          "sessionId": "S1",
          "command": {
            "command": "usage",
            "args": {}
          }
        }
      }
    ]
  },
  {
    "step": "600ms"
  },
  {
    "step": "_kiro.dev/session/update extends it"
  },
  {
    "step": "600ms more"
  },
  {
    "step": "_kiro.dev/metadata extends it"
  },
  {
    "step": "999ms more"
  },
  {
    "step": "1ms more: deadline",
    "=command2": [
      {
        "error": "ACPError",
        "message": "Request _kiro.dev/commands/execute exceeded its 1000ms recovery deadline",
        "method": "_kiro.dev/commands/execute",
        "sessionId": "S1"
      }
    ]
  },
  {
    "step": "load replay",
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "session/load",
        "params": {
          "sessionId": "L1",
          "cwd": "/work",
          "mcpServers": []
        }
      }
    ]
  },
  {
    "step": "600ms"
  },
  {
    "step": "a replayed frame does not reset the idle timer"
  },
  {
    "step": "400ms more: idle",
    "=load": [
      {
        "error": "ACPError",
        "message": "Request session/load idle for 1000ms (no updates from agent)",
        "method": "session/load",
        "sessionId": "L1"
      }
    ]
  },
  {
    "step": "state",
    "state": [
      {
        "sessionId": "L1",
        "alive": true,
        "hasSession": false,
        "needsSessionRecovery": false,
        "hasHealthyWork": false,
        "hasUnconfirmedExit": false,
        "info": "<undefined>",
        "sessionState": {
          "runtimeId": "kiro",
          "nativeEngine": "v2"
        }
      }
    ]
  },
  {
    "step": "a prompt never idles out",
    "p1": [
      {
        "sessionUpdate": "session_state",
        "state": {
          "runtimeId": "kiro",
          "version": "<version>",
          "currentModeId": "default",
          "modelId": "claude-x",
          "availableModes": [
            {
              "id": "default",
              "name": "Default"
            },
            {
              "id": "planner",
              "name": "Planner"
            }
          ],
          "availableModels": [
            {
              "id": "claude-x",
              "label": "X"
            }
          ],
          "nativeEngine": "v2"
        }
      },
      {
        "sessionUpdate": "context_usage",
        "contextUsagePercentage": 3
      }
    ],
    "perf": [
      [
        "mark",
        "acp:prompt_entered",
        {
          "sid": "S1",
          "textLen": 4
        }
      ],
      [
        "measure",
        "acp:prompt_to_first_update",
        {
          "sid": "S1",
          "kind": "session_state"
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "session/prompt",
        "params": {
          "sessionId": "S1",
          "prompt": [
            {
              "type": "text",
              "text": "long"
            }
          ]
        }
      }
    ]
  },
  {
    "step": "25s of silence",
    "p1": [
      {
        "sessionUpdate": "__heartbeat__",
        "idleMs": 25000
      },
      {
        "sessionUpdate": "__heartbeat__",
        "idleMs": 25000
      }
    ]
  },
  {
    "step": "prompt result",
    "p1": [
      {
        "sessionUpdate": "turn_end",
        "stopReason": "end_turn"
      },
      "<end>"
    ]
  }
]
