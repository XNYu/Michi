[
  {
    "step": "setup"
  },
  {
    "step": "start",
    "log": [
      [
        "info",
        "acp",
        "kiro process spawned",
        {
          "pid": 4242,
          "cwd": "/work",
          "model": "<undefined>",
          "binaryPath": "/fake/kiro-cli"
        }
      ]
    ],
    "perf": [
      [
        "mark",
        "acp:spawn_requested",
        {
          "cwd": "/work",
          "pid": 4242
        }
      ]
    ],
    "spawn": [
      {
        "bin": "/fake/kiro-cli",
        "args": [
          "acp",
          "--agent-engine",
          "v2"
        ],
        "cwd": "/work",
        "env": "<inherited>"
      }
    ],
    "startup": [
      [
        "kiro_spawn_start",
        {
          "cwd": "/work",
          "binaryPath": "/fake/kiro-cli"
        }
      ],
      [
        "kiro_spawn_done",
        {
          "cwd": "/work",
          "pid": 4242
        }
      ]
    ]
  },
  {
    "step": "initialize",
    "=initialize": [
      "<resolved>"
    ],
    "perf": [
      [
        "measure",
        "acp:initialize",
        {
          "cwd": "/work"
        }
      ]
    ],
    "startup": [
      [
        "kiro_initialize_start",
        {
          "cwd": "/work"
        }
      ],
      [
        "kiro_initialize_done",
        {
          "cwd": "/work"
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 0,
        "method": "initialize",
        "params": {
          "protocolVersion": 1,
          "clientInfo": {
            "name": "michi",
            "version": "1.0.0"
          },
          "clientCapabilities": {}
        }
      }
    ]
  },
  {
    "step": "session/new",
    "=newSession": [
      {
        "sessionId": "S1",
        "modes": {
          "currentModeId": "default",
          "availableModes": [
            {
              "id": "default",
              "name": "Default"
            },
            {
              "id": "planner",
              "name": "Planner"
            }
          ]
        },
        "models": {
          "currentModelId": "claude-x",
          "availableModels": [
            {
              "modelId": "claude-x",
              "name": "X"
            }
          ]
        }
      }
    ],
    "perf": [
      [
        "measure",
        "acp:session_new",
        {
          "cwd": "/work",
          "sessionId": "S1"
        }
      ]
    ],
    "startup": [
      [
        "kiro_session_new_start",
        {
          "cwd": "/work",
          "mcpServerCount": 0
        }
      ],
      [
        "kiro_session_new_done",
        {
          "cwd": "/work",
          "sessionId": "S1",
          "mcpServerCount": 0
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session/new",
        "params": {
          "cwd": "/work",
          "mcpServers": []
        }
      }
    ]
  },
  {
    "step": "prompt",
    "p1": [
      {
        "sessionUpdate": "session_state",
        "state": {
          "runtimeId": "kiro",
          "version": "<version>",
          "currentModeId": "default",
          "modelId": "claude-x",
          "availableModes": [
            {
              "id": "default",
              "name": "Default"
            },
            {
              "id": "planner",
              "name": "Planner"
            }
          ],
          "availableModels": [
            {
              "id": "claude-x",
              "label": "X"
            }
          ],
          "nativeEngine": "v2"
        }
      }
    ],
    "perf": [
      [
        "mark",
        "acp:prompt_entered",
        {
          "sid": "S1",
          "textLen": 4
        }
      ],
      [
        "measure",
        "acp:prompt_to_first_update",
        {
          "sid": "S1",
          "kind": "session_state"
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "session/prompt",
        "params": {
          "sessionId": "S1",
          "prompt": [
            {
              "type": "text",
              "text": "edit"
            }
          ]
        }
      }
    ]
  },
  {
    "step": "request",
    "p1": [
      {
        "sessionUpdate": "permission_request",
        "requestId": 3,
        "toolCall": {
          "toolCallId": "perm-3",
          "title": "Edit file"
        },
        "options": [
          {
            "optionId": "allow",
            "name": "Allow",
            "kind": "allow_once"
          },
          {
            "optionId": "always",
            "name": "Always",
            "kind": "allow_always"
          },
          {
            "optionId": "reject",
            "name": "Reject",
            "kind": "reject_once"
          }
        ],
        "_meta": {
          "kiro": {
            "consent": {
              "capability": "fs.write",
              "resource": "/a"
            }
          }
        }
      }
    ]
  },
  {
    "step": "answer",
    "=respond": [
      "<undefined>"
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "outcome": {
            "outcome": "selected",
            "optionId": "always"
          }
        }
      }
    ]
  },
  {
    "step": "prompt result",
    "p1": [
      {
        "sessionUpdate": "turn_end",
        "stopReason": "end_turn"
      },
      "<end>"
    ]
  }
]
