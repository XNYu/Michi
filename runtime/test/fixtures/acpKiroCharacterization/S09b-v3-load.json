      },
      {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "session/list",
        "params": {
          "cwd": "/work",
          "cursor": "page2",
          "_meta": {
            "kiro": {
              "scope": "workspace",
              "source": "local"
            }
