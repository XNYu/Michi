[
  {
    "step": "setup"
  },
  {
    "step": "first spawn",
    "log": [
      [
        "info",
        "acp",
        "kiro process spawned",
        {
          "pid": 4242,
          "cwd": "/work",
          "model": "m1",
          "binaryPath": "/fake/kiro-cli"
        }
      ]
    ],
    "perf": [
      [
        "mark",
        "acp:spawn_requested",
        {
          "cwd": "/work",
          "pid": 4242
        }
      ]
    ],
    "spawn": [
      {
        "bin": "/fake/kiro-cli",
        "args": [
          "acp",
          "--agent-engine",
          "v3",
          "--auth-method",
          "cli"
        ],
        "cwd": "/work",
        "env": {
          "HOST_MARKER": "read-1"
        }
      }
    ],
    "startup": [
      [
        "kiro_spawn_start",
        {
          "cwd": "/work",
          "binaryPath": "/fake/kiro-cli"
        }
      ],
      [
        "kiro_spawn_done",
        {
          "cwd": "/work",
          "pid": 4242
        }
      ]
    ]
  },
  {
    "step": "exit",
