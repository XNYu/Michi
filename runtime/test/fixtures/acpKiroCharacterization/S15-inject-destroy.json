[
  {
    "step": "setup"
  },
  {
    "step": "start",
    "log": [
      [
        "info",
        "acp",
        "kiro process spawned",
        {
          "pid": 4242,
          "cwd": "/work",
          "model": "<undefined>",
          "binaryPath": "/fake/kiro-cli"
        }
      ]
    ],
    "perf": [
      [
        "mark",
        "acp:spawn_requested",
        {
          "cwd": "/work",
          "pid": 4242
        }
      ]
    ],
    "spawn": [
      {
        "bin": "/fake/kiro-cli",
        "args": [
          "acp",
          "--agent-engine",
          "v2"
        ],
        "cwd": "/work",
        "env": "<inherited>"
      }
    ],
    "startup": [
      [
        "kiro_spawn_start",
        {
          "cwd": "/work",
          "binaryPath": "/fake/kiro-cli"
        }
      ],
      [
        "kiro_spawn_done",
        {
          "cwd": "/work",
          "pid": 4242
        }
      ]
    ]
  },
  {
    "step": "initialize",
    "=initialize": [
      "<resolved>"
    ],
    "perf": [
      [
        "measure",
        "acp:initialize",
        {
          "cwd": "/work"
        }
      ]
    ],
    "startup": [
      [
        "kiro_initialize_start",
        {
          "cwd": "/work"
        }
      ],
      [
        "kiro_initialize_done",
        {
          "cwd": "/work"
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 0,
        "method": "initialize",
        "params": {
          "protocolVersion": 1,
          "clientInfo": {
            "name": "michi",
            "version": "1.0.0"
          },
          "clientCapabilities": {}
        }
      }
    ]
  },
  {
    "step": "session/new",
    "=newSession": [
      {
        "sessionId": "S1",
        "modes": {
          "currentModeId": "default",
          "availableModes": [
            {
              "id": "default",
              "name": "Default"
            },
            {
              "id": "planner",
              "name": "Planner"
            }
          ]
        },
        "models": {
          "currentModelId": "claude-x",
          "availableModels": [
            {
              "modelId": "claude-x",
              "name": "X"
            }
          ]
        }
      }
    ],
    "perf": [
      [
        "measure",
        "acp:session_new",
        {
          "cwd": "/work",
          "sessionId": "S1"
        }
      ]
    ],
    "startup": [
      [
        "kiro_session_new_start",
        {
          "cwd": "/work",
          "mcpServerCount": 0
        }
      ],
      [
        "kiro_session_new_done",
        {
          "cwd": "/work",
          "sessionId": "S1",
          "mcpServerCount": 0
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session/new",
        "params": {
          "cwd": "/work",
          "mcpServers": []
        }
      }
    ]
  },
  {
    "step": "inject between turns",
    "=inject": [
      true
    ],
    "=injectUnknown": [
      false
    ]
  },
  {
    "step": "prompt drains it",
    "p1": [
      {
        "sessionUpdate": "session_state",
        "state": {
          "runtimeId": "kiro",
          "version": "<version>",
          "currentModeId": "default",
          "modelId": "claude-x",
          "availableModes": [
            {
              "id": "default",
              "name": "Default"
            },
            {
              "id": "planner",
              "name": "Planner"
            }
          ],
          "availableModels": [
            {
              "id": "claude-x",
              "label": "X"
            }
          ],
          "nativeEngine": "v2"
        }
      }
    ],
    "perf": [
      [
        "mark",
        "acp:prompt_entered",
        {
          "sid": "S1",
          "textLen": 1
        }
      ],
      [
        "measure",
        "acp:prompt_to_first_update",
        {
          "sid": "S1",
          "kind": "session_state"
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "session/prompt",
        "params": {
          "sessionId": "S1",
          "prompt": [
            {
              "type": "text",
              "text": "x"
            }
          ]
        }
      }
    ]
  },
  {
    "step": "inject during the prompt",
    "=inject2": [
      true
    ],
    "p1": [
      {
        "sessionUpdate": "spawn_branches",
        "count": 3
      }
    ]
  },
  {
    "step": "prompt result",
    "p1": [
      {
        "sessionUpdate": "turn_end",
        "stopReason": "end_turn"
      },
      "<end>"
    ]
  },
  {
    "step": "destroy"
  },
  {
    "step": "after destroy",
    "=cancel": [
      false
    ],
    "=inject3": [
      false
    ],
    "p2": [
      {
        "error": "ACPError",
        "message": "unknown session: S1"
      }
    ],
    "perf": [
      [
        "mark",
        "acp:prompt_entered",
        {
          "sid": "S1",
          "textLen": 1
        }
      ]
    ],
    "state": [
      {
        "sessionId": "S1",
        "alive": true,
        "hasSession": false,
        "needsSessionRecovery": false,
        "hasHealthyWork": false,
        "hasUnconfirmedExit": false,
        "info": "<undefined>",
        "sessionState": {
          "runtimeId": "kiro",
          "nativeEngine": "v2"
        }
      }
    ]
  },
  {
    "step": "fork an active session",
    "=newSession2": [
      {
        "sessionId": "S2",
        "modes": {
          "currentModeId": "default",
          "availableModes": [
            {
              "id": "default",
              "name": "Default"
            },
            {
              "id": "planner",
              "name": "Planner"
            }
          ]
        },
        "models": {
          "currentModelId": "claude-x",
          "availableModels": [
            {
              "modelId": "claude-x",
              "name": "X"
            }
          ]
        }
      }
    ],
    "perf": [
      [
        "measure",
        "acp:session_new",
        {
          "cwd": "/work",
          "sessionId": "S2"
        }
      ]
    ],
    "startup": [
      [
        "kiro_session_new_start",
        {
          "cwd": "/work",
          "mcpServerCount": 0
        }
      ],
      [
        "kiro_session_new_done",
        {
          "cwd": "/work",
          "sessionId": "S2",
          "mcpServerCount": 0
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "session/new",
        "params": {
          "cwd": "/work",
          "mcpServers": []
        }
      }
    ]
  },
  {
    "step": "prompt on it",
    "p3": [
      {
        "sessionUpdate": "session_state",
        "state": {
          "runtimeId": "kiro",
          "version": "<version>",
          "currentModeId": "default",
          "modelId": "claude-x",
          "availableModes": [
            {
              "id": "default",
              "name": "Default"
            },
            {
              "id": "planner",
              "name": "Planner"
            }
          ],
          "availableModels": [
            {
              "id": "claude-x",
              "label": "X"
            }
          ],
          "nativeEngine": "v2"
        }
      }
    ],
    "perf": [
      [
        "mark",
        "acp:prompt_entered",
        {
          "sid": "S2",
          "textLen": 4
        }
      ],
      [
        "measure",
        "acp:prompt_to_first_update",
        {
          "sid": "S2",
          "kind": "session_state"
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "session/prompt",
        "params": {
          "sessionId": "S2",
          "prompt": [
            {
              "type": "text",
              "text": "busy"
            }
          ]
        }
      }
    ]
  },
  {
    "step": "fork refused",
    "=fork": [
      {
        "error": "ACPError",
        "message": "Cannot fork an active Kiro session"
      }
    ]
  },
  {
    "step": "prompt result",
    "p3": [
      {
        "sessionUpdate": "turn_end",
        "stopReason": "end_turn"
      },
      "<end>"
    ]
  }
]
