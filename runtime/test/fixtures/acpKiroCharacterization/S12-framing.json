[
  {
    "step": "setup"
  },
  {
    "step": "start",
    "log": [
      [
        "info",
        "acp",
        "kiro process spawned",
        {
          "pid": 4242,
          "cwd": "/work",
          "model": "<undefined>",
          "binaryPath": "/fake/kiro-cli"
        }
      ]
    ],
    "perf": [
      [
        "mark",
        "acp:spawn_requested",
        {
          "cwd": "/work",
          "pid": 4242
        }
      ]
    ],
    "spawn": [
      {
        "bin": "/fake/kiro-cli",
        "args": [
          "acp",
          "--agent-engine",
          "v2"
        ],
        "cwd": "/work",
        "env": "<inherited>"
      }
    ],
    "startup": [
      [
        "kiro_spawn_start",
        {
          "cwd": "/work",
          "binaryPath": "/fake/kiro-cli"
        }
      ],
      [
        "kiro_spawn_done",
        {
          "cwd": "/work",
          "pid": 4242
        }
      ]
    ]
  },
  {
    "step": "initialize",
    "=initialize": [
      "<resolved>"
    ],
    "perf": [
      [
        "measure",
        "acp:initialize",
        {
          "cwd": "/work"
        }
      ]
    ],
    "startup": [
      [
        "kiro_initialize_start",
        {
          "cwd": "/work"
        }
      ],
      [
        "kiro_initialize_done",
        {
          "cwd": "/work"
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 0,
        "method": "initialize",
        "params": {
          "protocolVersion": 1,
          "clientInfo": {
            "name": "michi",
            "version": "1.0.0"
          },
          "clientCapabilities": {}
        }
      }
    ]
  },
  {
    "step": "session/new",
    "=newSession": [
      {
        "sessionId": "S1",
        "modes": {
          "currentModeId": "default",
          "availableModes": [
            {
              "id": "default",
              "name": "Default"
            },
            {
              "id": "planner",
              "name": "Planner"
            }
          ]
        },
        "models": {
          "currentModelId": "claude-x",
          "availableModels": [
            {
              "modelId": "claude-x",
              "name": "X"
            }
          ]
        }
      }
    ],
    "perf": [
      [
        "measure",
        "acp:session_new",
        {
          "cwd": "/work",
          "sessionId": "S1"
        }
      ]
    ],
    "startup": [
      [
        "kiro_session_new_start",
        {
          "cwd": "/work",
          "mcpServerCount": 0
        }
      ],
      [
        "kiro_session_new_done",
        {
          "cwd": "/work",
          "sessionId": "S1",
          "mcpServerCount": 0
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session/new",
        "params": {
          "cwd": "/work",
          "mcpServers": []
        }
      }
    ]
  },
  {
    "step": "prompt",
    "p1": [
      {
        "sessionUpdate": "session_state",
        "state": {
          "runtimeId": "kiro",
          "version": "<version>",
          "currentModeId": "default",
          "modelId": "claude-x",
          "availableModes": [
            {
              "id": "default",
              "name": "Default"
            },
            {
              "id": "planner",
              "name": "Planner"
            }
          ],
          "availableModels": [
            {
              "id": "claude-x",
              "label": "X"
            }
          ],
          "nativeEngine": "v2"
        }
      }
    ],
    "perf": [
      [
        "mark",
        "acp:prompt_entered",
        {
          "sid": "S1",
          "textLen": 6
        }
      ],
      [
        "measure",
        "acp:prompt_to_first_update",
        {
          "sid": "S1",
          "kind": "session_state"
        }
      ]
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "session/prompt",
        "params": {
          "sessionId": "S1",
          "prompt": [
            {
              "type": "text",
              "text": "frames"
            }
          ]
        }
      }
    ]
  },
  {
    "step": "split, blank, malformed and CRLF lines",
    "p1": [
      {
        "sessionUpdate": "agent_message_chunk",
        "content": {
          "type": "text",
          "text": "split across reads"
        }
      },
      {
        "sessionUpdate": "agent_message_chunk",
        "content": {
          "type": "text",
          "text": "crlf"
        }
      },
      {
        "sessionUpdate": "agent_message_chunk",
        "content": {
          "type": "text",
          "text": "second"
        }
      }
    ],
    "perf": [
      [
        "measure",
        "acp:prompt_to_first_chunk",
        {
          "sid": "S1"
        }
      ]
    ]
  },
  {
    "step": "terminate the last line",
    "p1": [
      {
        "sessionUpdate": "agent_message_chunk",
        "content": {
          "type": "text",
          "text": "unterminated"
        }
      }
    ]
  },
  {
    "step": "agent requests the client does not serve",
    "p1": [
      {
        "sessionUpdate": "agent_message_chunk",
        "content": {
          "type": "text",
          "text": "null id"
        }
      }
    ],
    "wire": [
      {
        "jsonrpc": "2.0",
        "id": 60,
        "error": {
          "code": -32601,
          "message": "Unsupported client method: fs/read_text_file"
        }
      },
      {
        "jsonrpc": "2.0",
        "id": "str",
        "error": {
          "code": -32601,
          "message": "Unsupported client method: terminal/create"
        }
      }
    ]
  },
  {
    "step": "responses for unknown requests and stray frames",
    "p1": [
      {
        "sessionId": "S1"
      }
    ]
  },
  {
    "step": "prompt result",
    "p1": [
      {
        "sessionUpdate": "turn_end",
        "stopReason": "end_turn"
      },
      "<end>"
    ]
  }
]
