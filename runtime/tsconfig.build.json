{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "stripInternal": true,
    "useDefineForClassFields": false,
    "resolveJsonModule": false
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
