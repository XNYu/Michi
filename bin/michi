#!/usr/bin/env bash
set -euo pipefail

# --- Resolve install directory (follows symlinks) ---
SCRIPT="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")"
INSTALL_DIR="$(cd "$(dirname "$SCRIPT")/.." && pwd)"

# Node selection uses the minimum in package.json.
source "$INSTALL_DIR/bin/lib/node-select.sh"

# --- Linux remote backend ---
# A data directory with remote.env belongs to the backend that the desktop app
# and phone connect to. There `michi` acts on that backend, whichever release
# this launcher came from; each launch points ~/.local/bin/michi at its build.
REMOTE_ROOT="$HOME/.local/share/michi/devdesktop"

remote_fail() { echo "✖ $*" >&2; exit 1; }

remote_node() {
  local minimum
  minimum="$(michi_node_minimum "$INSTALL_DIR")" \
    || remote_fail "Could not read engines.node from $INSTALL_DIR/package.json"
  # Prefer the Node that the desktop app's remote setup installed.
  michi_select_node "$minimum" "$REMOTE_ROOT/node/bin/node" \
    || remote_fail "Michi needs Node.js $minimum or newer"
  REMOTE_NODE="$MICHI_NODE"
}

# Prints the checkout whose server.js a pid or installation record names; with
# "alive", only while that process still runs.
remote_record_repo() {
  [ -f "$1" ] || return 1
  "$REMOTE_NODE" -e '
const fs = require("node:fs"), path = require("node:path");
const [file, mode] = process.argv.slice(1);
try {
  const record = JSON.parse(fs.readFileSync(file, "utf8"));
  const repo = path.resolve(record.serverPath, "../../..");
  if (path.basename(record.serverPath) !== "server.js" || !fs.existsSync(path.join(repo, "scripts/remote-control.mjs"))) process.exit(1);
  if (mode === "alive") { try { process.kill(record.pid, 0); } catch (error) { if (error.code !== "EPERM") process.exit(1); } }
  process.stdout.write(repo);
} catch { process.exit(1); }' "$1" "${2:-}"
}

# The build that owns the data directory, resolved as the desktop app does.
remote_repo() {
  remote_record_repo "$REMOTE_DATA/remote-installation.json" \
    || remote_record_repo "$REMOTE_DATA/remote.pid" \
    || { [ -f "$INSTALL_DIR/scripts/remote-control.mjs" ] && printf '%s' "$INSTALL_DIR"; } \
    || remote_fail "No Michi build found for $REMOTE_DATA"
}

# remote-control.mjs only stops or reports a process started from its own checkout.
remote_running_repo() {
  remote_record_repo "$REMOTE_DATA/remote.pid" alive || remote_repo
}

remote_control() {
  local repo="$1"
  shift
  (cd "$repo" && env -u PORT -u MICHI_REMOTE_TOKEN -u MICHI_BIND_HOST \
    "$REMOTE_NODE" scripts/remote-control.mjs "$@" --data-dir "$REMOTE_DATA")
}

remote_revision() {
  remote_control "$1" status 2>/dev/null | sed -n 's/^revision: //p' || true
}

# Same order as the desktop app's update: build beside the running backend,
# stop it from its own checkout, start the new build, and restore the old one
# if the new build does not start.
remote_update() {
  local force=0 arg old_repo repo url ref revision attempt log
  for arg in "$@"; do
    case "$arg" in
      --force|-f) force=1 ;;
      *) remote_fail "unknown option: $arg" ;;
    esac
  done
  url="${MICHI_REMOTE_SOURCE_URL:-https://github.com/XNYu/Michi.git}"
  ref="${MICHI_REMOTE_SOURCE_REF:-main}"
  old_repo="$(remote_running_repo)"
  mkdir -p "$REMOTE_ROOT/releases"
  mkdir "$REMOTE_ROOT/setup.lock" 2>/dev/null || remote_fail "Another Michi setup or update is running"
  if ! mkdir "$REMOTE_DATA/remote-recovery.lock" 2>/dev/null; then
    rmdir "$REMOTE_ROOT/setup.lock"
    remote_fail "Another Michi setup or update is running"
  fi
  trap 'rmdir "$REMOTE_ROOT/setup.lock" "$REMOTE_DATA/remote-recovery.lock" 2>/dev/null || true' EXIT

  if [ "$force" -ne 1 ] && [ -n "$(git -C "$old_repo" status --porcelain --untracked-files=normal -- . ':!package-lock.json' 2>/dev/null || true)" ]; then
    remote_fail "The running build in $old_repo has local source changes that the update would not keep. Re-run with: michi update --force"
  fi
  revision="$(git ls-remote "$url" "refs/heads/$ref" | cut -f1)"
  [ -n "$revision" ] || remote_fail "Could not read $ref from $url"
  if [ "$(remote_revision "$old_repo")" = "$revision" ]; then
    echo "✔ Michi is already at $ref (${revision:0:8})"
    return 0
  fi

  attempt="$("$REMOTE_NODE" -e 'process.stdout.write(require("node:crypto").randomUUID())')"
  repo="$REMOTE_ROOT/releases/$revision-$attempt"
  log="$REMOTE_ROOT/update.$attempt.log"
  (umask 077 && : >"$log")
  echo "🐰 Building $ref ${revision:0:8} (log: $log)"
  # scripts/build-edition.cjs selects the internal edition from a Git remote
  # named amazon. Name the new checkout's remote like the running one's, so an
  # update keeps the build's edition.
  remote_name=origin
  if git -C "$old_repo" remote get-url amazon >/dev/null 2>&1; then remote_name=amazon; fi
  if ! (git clone --no-checkout --single-branch --branch "$ref" --origin "$remote_name" -- "$url" "$repo" \
    && git -C "$repo" checkout --detach "$revision") >>"$log" 2>&1; then
    tail -n 20 "$log"
    remote_fail "Could not fetch $ref; Michi keeps running $old_repo"
  fi
  if ! (cd "$repo" && MICHI_DATA_DIR="$REMOTE_DATA" MICHI_CONFIG_DIR="$REMOTE_DATA" MICHI_LOG_DIR="$REMOTE_DATA/logs" \
    npm run remote:setup) >>"$log" 2>&1; then
    tail -n 20 "$log"
    remote_fail "Build failed; Michi keeps running $old_repo"
  fi

  echo "🐰 Switching to the new build; running chats will be interrupted"
  if ! remote_control "$old_repo" stop >>"$log" 2>&1; then
    tail -n 20 "$log"
    remote_fail "Could not stop the backend running from $old_repo"
  fi
  if ! remote_control "$repo" launch --no-setup >>"$log" 2>&1; then
    remote_control "$repo" stop >>"$log" 2>&1 || true
    remote_control "$old_repo" launch --no-setup >>"$log" 2>&1 || true
    tail -n 20 "$log"
    remote_fail "The new build did not start; restarted $old_repo"
  fi
  [ "$(remote_revision "$repo")" = "$revision" ] \
    || remote_fail "The backend did not report ${revision:0:8} after the switch; see $log"
  echo "✔ Michi updated to $(git -C "$repo" log -1 --format='%h %s')"
}

remote_usage() {
  cat <<EOF
Usage: michi [command] [--data-dir PATH]

Manages the Michi backend that the desktop app and phone connect to.

Commands:
  start     Start the backend (default)
  stop      Stop the backend
  restart   Stop then start
  status    Show whether the backend runs, and its revision
  logs      Follow the backend log
  update    Build the latest main beside the running backend, then switch to it
            (--force: update even if the running build has local changes)

Flags:
  --data-dir PATH  Data directory of the backend (default: ~/.michi)
  --help           Show this help
  --version        Show version
EOF
}

remote_main() {
  local repo
  remote_node
  case "${1:-start}" in
    start)
      repo="$(remote_repo)"
      remote_control "$repo" launch --no-setup
      ;;
    stop)
      repo="$(remote_running_repo)"
      remote_control "$repo" stop
      ;;
    restart)
      repo="$(remote_running_repo)"
      remote_control "$repo" stop
      repo="$(remote_repo)"
      remote_control "$repo" launch --no-setup
      ;;
    status)
      repo="$(remote_running_repo)"
      remote_control "$repo" status
      ;;
    logs)
      if [ -f "$HOME/.config/systemd/user/michi-remote.service" ]; then
        exec journalctl --user -u michi-remote.service -f
      fi
      exec tail -n 50 -f "$REMOTE_DATA/remote.log"
      ;;
    update)
      shift
      remote_update "$@"
      ;;
    --help|-h) remote_usage ;;
    --version|-v)
      repo="$(remote_repo)"
      echo "$("$REMOTE_NODE" -e 'process.stdout.write(require(process.argv[1] + "/package.json").version)' "$repo") ($(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo unknown))"
      ;;
    *)
      remote_usage >&2
      exit 1
      ;;
  esac
}

if [[ "$(uname -s)" == "Linux" ]]; then
  REMOTE_DATA="${MICHI_DATA_DIR:-$HOME/.michi}"
  remote_argc=$#
  for ((remote_index = 0; remote_index < remote_argc; remote_index++)); do
    remote_arg="$1"
    shift
    case "$remote_arg" in
      --data-dir)
        REMOTE_DATA="${1:?--data-dir requires a path}"
        shift
        remote_index=$((remote_index + 1))
        ;;
      --data-dir=*) REMOTE_DATA="${remote_arg#--data-dir=}" ;;
      *) set -- "$@" "$remote_arg" ;;
    esac
  done
  REMOTE_DATA="${REMOTE_DATA/#\~/$HOME}"
  if [ -f "$REMOTE_DATA/remote.env" ]; then
    remote_main "$@"
    exit 0
  fi
fi

configure_build_node() {
  local minimum
  if ! minimum="$(michi_node_minimum "$INSTALL_DIR")"; then
    echo "✖ Could not read engines.node from $INSTALL_DIR/package.json"
    exit 1
  fi
  if ! michi_select_node "$minimum"; then
    echo "✖ Could not find a usable Node.js $minimum+ for Michi."
    echo "  Install one with: brew install node  (macOS)"
    echo "  Or: mise use -g node@${minimum%%.*}  (Linux)"
    exit 1
  fi
}

# Copies a newer build through the shared app installer.
sync_app_bundle() {
  [[ "$(uname -s)" == "Darwin" ]] || return 0
  if ! command -v node >/dev/null 2>&1; then
    echo "⚠ node not found; ~/Applications/michi.app was not updated" >&2
    return 0
  fi
  node "$INSTALL_DIR/scripts/install-app.mjs" --if-newer
}

case "${1:-}" in
  --help|-h)
    cat <<EOF
Usage: michi [--help] [--version] [update]

Commands:
  update    Pull latest code and reinstall dependencies
  (none)    Launch the Michi desktop app

Flags:
  --help    Show this help
  --version Show version
EOF
    exit 0
    ;;
  --version|-v)
    node -e "process.stdout.write(require('$INSTALL_DIR/package.json').version)" 2>/dev/null || echo "unknown"
    echo
    exit 0
    ;;
  update)
    echo "🐰 Updating Michi…"
    configure_build_node

    # Track a conventional public release branch. This mirrors
    # backend/src/routes/version.ts pickUpstream() + 3 safety guards.
    FORCE=0
    for arg in "${@:2}"; do
      [[ "$arg" == "--force" || "$arg" == "-f" ]] && FORCE=1
    done

    REMOTE=""
    REMOTE_BRANCH=""
    for candidate in origin/main origin/master github/main github/master; do
      if git -C "$INSTALL_DIR" rev-parse --verify "refs/remotes/$candidate" >/dev/null 2>&1; then
        REMOTE="${candidate%%/*}"
        REMOTE_BRANCH="$candidate"
        break
      fi
    done

    if [ -z "$REMOTE" ]; then
      echo "✖ No supported release branch found."
      echo "  Add a remote with origin/main or origin/master, then retry."
      exit 1
    fi
    git -C "$INSTALL_DIR" fetch "$REMOTE" --quiet
    if ! git -C "$INSTALL_DIR" rev-parse --verify "refs/remotes/$REMOTE_BRANCH" >/dev/null 2>&1; then
      echo "✖ '$REMOTE_BRANCH' not found after fetch."
      exit 1
    fi

    # Safety 1: refuse if HEAD is ahead of upstream (would silently drop local commits).
    AHEAD="$(git -C "$INSTALL_DIR" rev-list --count "$REMOTE_BRANCH..HEAD" 2>/dev/null || echo 0)"
    if [ "${AHEAD:-0}" -gt 0 ] && [ "$FORCE" -ne 1 ]; then
      echo "✖ $AHEAD local commit(s) ahead of $REMOTE_BRANCH would be hard-reset away."
      echo "  Back them up first, or re-run with: michi update --force"
      exit 1
    fi

    # Safety 2: refuse if tracked files are dirty (untracked files survive reset).
    DIRTY="$(git -C "$INSTALL_DIR" status --porcelain --untracked-files=no)"
    if [ -n "$DIRTY" ] && [ "$FORCE" -ne 1 ]; then
      echo "✖ Uncommitted changes in tracked files would be discarded by reset:"
      printf '%s\n' "$DIRTY" | sed 's/^/    /'
      echo "  Commit or stash them first, or re-run with: michi update --force"
      exit 1
    fi

    # Safety 3: snapshot HEAD to a recoverable ref name (not just reflog).
    TS="$(date -u +%Y-%m-%dT%H-%M-%SZ)"
    BACKUP_REF="refs/michi/pre-update/$TS"
    HEAD_SHA="$(git -C "$INSTALL_DIR" rev-parse HEAD)"
    git -C "$INSTALL_DIR" update-ref "$BACKUP_REF" "$HEAD_SHA"
    echo "  ↳ backup: $BACKUP_REF → $HEAD_SHA"

    git -C "$INSTALL_DIR" reset --hard "$REMOTE_BRANCH" --quiet
    if [ -f "$INSTALL_DIR/package-lock.json" ]; then
      (cd "$INSTALL_DIR" && npm ci --no-fund --no-audit --loglevel=error)
    else
      (cd "$INSTALL_DIR" && npm install --no-fund --no-audit --loglevel=error)
    fi
    if [[ "$(uname -s)" == "Darwin" ]]; then
      find "$INSTALL_DIR/node_modules" -name '*.node' -print0 | \
        xargs -0 -I{} codesign --force --sign - '{}' 2>/dev/null || true
    fi
    (cd "$INSTALL_DIR" && npm run electron:build)
    echo "✔ Updated to $(git -C "$INSTALL_DIR" log -1 --format='%h %s')"
    exit 0
    ;;
esac

USER_CWD="$(pwd)"

cd "$INSTALL_DIR"

# Read port from .env if it exists
if [ -f "$INSTALL_DIR/.env" ]; then
  # shellcheck disable=SC1091
  source "$INSTALL_DIR/.env"
fi
export PORT="${PORT:-4649}"

BUILT_APP="${INSTALL_DIR}/dist-electron/mac-arm64/michi.app"
if [ ! -d "$BUILT_APP" ]; then
  echo "🐰 App not built yet — building…"
  configure_build_node
  (cd "$INSTALL_DIR" && npm run electron:build)
fi

# Keep ~/Applications/michi.app in sync with the build, then prefer it as the
# launch target so `michi` (CLI) and Spotlight both resolve to the same bundle.
sync_app_bundle
APP_PATH="${HOME}/Applications/michi.app"
[ -d "$APP_PATH" ] || APP_PATH="$BUILT_APP"

# `open` launches via launchctl and doesn't inherit the shell's cwd or
# environment. Forward the user's shell pwd via --env so the picker can
# default to it (B); falls back gracefully on older macOS where --env is
# unsupported.
exec open --env "MICHI_LAUNCH_CWD=$USER_CWD" "$APP_PATH"
